# ========================
# Terraform
# ========================

# Local .terraform directories (providers, plugins)
**/.terraform/*

# .tfstate files (contain sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Plan files
tfplan*
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (regenerated on init)
.terraform.lock.hcl

# Archives generated by Terraform (archive_file)
*.zip

# ========================
# Node.js (Lambda functions)
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ========================
# IDE / Editor
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
# OS files
# ========================
.DS_Store
Thumbs.db
Desktop.ini

# ========================
# Misc
# ========================
response.json
*.bak
